{
  "manifest_version": 3,
  "name": "Arc Cmdbar",
  "version": "0.1.0",
  "key": "",
  "description": "Arc 风格的命令栏：一个搜索框搜标签页、最近关闭、书签、历史记录和常用命令。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "sessions",
    "bookmarks",
    "history",
    "favicon",
    "storage",
    "search",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Arc Cmdbar",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "打开命令栏"
    }
  }
}
